# Copy values into the backend process environment. Never commit real secrets.
DB_URL=jdbc:mariadb://localhost:3306/barangayease_db
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_EXPIRATION_SECONDS=28800
PORT=8080
UPLOAD_DIR=uploads
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional AI providers. If not configured, AI features use fallback behavior.
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
